digraph async_state {
  rankdir=LR
  node [shape=box]
  subgraph cluster_task {
    label="task process"
    t [label="link to caller\nmonitored by caller\n$callers = [caller]\n$ancestors = [caller]\nheap: 233 words"]
  }
  subgraph cluster_caller {
    label="caller process"
    c [label="link to task\nmonitor on task\nmailbox, once the task is done:\n1. {ref, result}\n2. {:DOWN, ref, :process, pid, :normal}" class=hl]
  }
  c -> t [label=" Task.async"]
  t -> c [label=" copies the result" style=dashed]
}

digraph with_chain {
  node [shape=box]
  r [label="read_line(socket)\n{:ok, data} <-"]
  p [label="KV.Command.parse(data)\n{:ok, command} <-"]
  u [label="KV.Command.run(command, socket)" class=hl]
  w [label="write_line(socket, msg)"]
  r -> p [label=" match"]
  p -> u [label=" match"]
  u -> w [label=" :ok  or  {:error, :not_found}"]
  r -> w [label=" {:error, :closed}: no match, so with\l returns it as is; write_line exits politely\l" class=bad style=dashed]
  p -> w [label=" {:error, :unknown_command}\l" class=bad style=dashed]
}

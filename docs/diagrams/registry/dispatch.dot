digraph dispatch {
  rankdir=LR
  node [shape=box]
  subgraph cluster_reg {
    label="Registry (duplicate keys)"
    e [label="\"hello\" -> [{pid A, v1}, {pid B, v2}]"]
  }
  caller [label="caller\nRegistry.dispatch(reg, \"hello\", fun)" class=hl]
  caller -> e [label=" 1. reads the entries"]
  e -> caller [label=" 2. [{pid, value}, ...]"]
  caller -> a [label=" 3. fun runs in the caller:\napply(...) or send(pid, msg)" style=dashed]
  a [label="registered processes\nnot involved unless fun contacts them"]
}

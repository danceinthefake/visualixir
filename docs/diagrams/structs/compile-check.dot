digraph compile_check {
  rankdir=LR
  node [shape=box]
  def [label="defstruct name: \"John\", age: 27"]
  ok1 [label="%User{name: \"Jane\"}" class=hl]
  res [label="%User{name: \"Jane\", age: 27}"]
  bad [label="%User{oops: :field}"]
  err [label="KeyError\n(caught when compiling)"]
  def -> ok1 [label=" fields known;\l age takes its default\l"]
  ok1 -> res
  def -> bad [label=" unknown field" class=bad style=dashed]
  bad -> err [class=bad style=dashed]
}

digraph aliases {
  rankdir=LR
  node [shape=box]
  a1 [label="String"]
  b1 [label=":\"Elixir.String\"" class=hl]
  a2 [label="MyApp.String"]
  b2 [label=":\"Elixir.MyApp.String\"" class=hl]
  a3 [label="alias MyApp.Example, as: Example\nthen Example.String"]
